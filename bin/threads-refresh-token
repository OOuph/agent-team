#!/usr/bin/env bash
# Refresh the long-lived Threads token in .env (valid 60 days; refreshable after 24 h, before expiry).
# Usage: bin/threads-refresh-token [path/to/.env]   — prints only the new expiry, never the token.
HERE="$(cd "$(dirname "$0")/.." && pwd)"
PY="$HERE/.venv/bin/python"; [ -x "$PY" ] || PY=python3
cd "$HERE" || exit 1
exec "$PY" -m team.threads_token "${1:-$HERE/.env}"
