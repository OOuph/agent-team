# /etc/agent-team/services/<slug>.conf — one file per service, written by add-service.sh (plain shell assignments,
# sourced by deploy-service.sh). Secrets are NOT here: /etc/agent-team/services/<slug>.secrets.env (root:ubuntu 0640),
# filled in by the owner by hand and sourced by svc-run.sh right before the server starts.
HOST=fleets.formachines.ai
REPO=https://github.com/formachines-ai/fleets.git
BRANCH=main
RUN_CMD="npm run start"
BUILD_CMD="npm run build"
INSTALL_CMD=""               # empty = npm ci when package-lock.json exists, else npm install (only when package.json exists)
HEALTH_PATH=/healthz
PORT_A=8101                  # colour a
PORT_B=8102                  # colour b — the deploy alternates between the two; nginx proxies to the live one
# Optional, normally absent. git, install and build of a deploy run as the service user (ubuntu), never as root.
# A private repository: REPO=git@github.com:org/game.git with a deploy key in ~ubuntu/.ssh, or an https REPO read with
# the token of the dispatcher through /opt/agent-team/bin/git-credential-dispatcher (the default for https; README).
#GIT_CREDENTIAL_HELPER=""                                  # no helper: public repository, or the git config of the service user
#DISPATCHER_ENV_FILE=/home/ubuntu/agent-team/dispatcher/.env   # where the helper reads GITHUB_TOKEN (this is its default)
