[Unit]
Description=agent-team service instance %i (a game server release; deploy-service.sh starts one colour per deploy)
Documentation=file:///opt/agent-team/service/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
Group=__USER__
ExecStart=/opt/agent-team/bin/svc-run.sh %i
# always, not on-failure (ai-battles 21.11, F36): a role ran `pkill -f dist/server/index.js` to stop its own test server and
# stopped the live one too (same user, same command line); the server exits 0 on SIGTERM, so on-failure left the game
# down for 14 minutes. `systemctl stop` (deploy-service.sh, the old colour) still stops an instance for good.
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=mixed
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/agent-team/services
StandardOutput=journal
StandardError=journal
