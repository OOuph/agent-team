#!/usr/bin/env bash
# git-credential-dispatcher — git credential helper for the service deploy (deploy-service.sh). Git calls it as
# `git-credential-dispatcher get` when an https remote asks for a login; it answers with the GitHub token of the
# dispatcher, read from the dispatcher's .env at that moment. The token is never copied: not into this file, not into
# the clone's URL, not into a git credential store (`store` and `erase` do nothing).
#
# Why it exists (ai-battles launch, friction F11): the organisation's policy forbids deploy keys, so the private game
# repository is read over https with the token the dispatcher already has. Until 22.11 a hand-made copy of this helper
# lived on the server only, for root. Now the clone is made by the service user (deploy-service.sh drops root for
# everything that touches the repository), and this file is installed by install.sh (root:root 0755, no secret inside).
#
# Who can use it: whoever can read the .env. On the droplet the dispatcher and the services run as the same user
# (`ubuntu`, .env 0600), so the helper works for the deploy and gives that user nothing it did not have. A service user
# separate from the dispatcher's cannot read the .env: use a deploy key, or point AGENT_TEAM_DISPATCHER_ENV at a file
# that user may read (KEY=value lines, a read-only token for the game repository).
#
# It answers only for protocol https and the host below — the token never goes to another host.
#
# Settings (environment; deploy-service.sh passes AGENT_TEAM_DISPATCHER_ENV when DISPATCHER_ENV_FILE is set in <slug>.conf):
#   AGENT_TEAM_DISPATCHER_ENV   the .env to read                  (default ~/agent-team/dispatcher/.env)
#   AGENT_TEAM_TOKEN_VAR        the variable in it                (default GITHUB_TOKEN)
#   AGENT_TEAM_CREDENTIAL_HOST  the only host it answers for      (default github.com)
#   AGENT_TEAM_CREDENTIAL_USER  the username sent with the token  (default x-access-token)
#   AGENT_TEAM_CREDENTIAL_LOG   append one line per call here     (default: none; lines also go to stderr = the deploy output)
# Check by hand (prints the username line only):
#   printf 'protocol=https\nhost=github.com\n\n' | /opt/agent-team/bin/git-credential-dispatcher get | grep -v '^password='
set -euo pipefail

ENV_FILE="${AGENT_TEAM_DISPATCHER_ENV:-${HOME:-/nonexistent}/agent-team/dispatcher/.env}"
TOKEN_VAR="${AGENT_TEAM_TOKEN_VAR:-GITHUB_TOKEN}"
ALLOW_HOST="${AGENT_TEAM_CREDENTIAL_HOST:-github.com}"
CRED_USER="${AGENT_TEAM_CREDENTIAL_USER:-x-access-token}"
LOG_FILE="${AGENT_TEAM_CREDENTIAL_LOG:-}"

# note <LEVEL> <text>: stderr (git shows it in the deploy output) and the optional log file; never the token
note() {
  local line
  line="$(date -u +%Y-%m-%dT%H:%M:%SZ) git-credential-dispatcher $1 $2"
  echo "$line" >&2
  if [ -n "$LOG_FILE" ]; then echo "$line" >> "$LOG_FILE" 2>/dev/null || true; fi
}

# git also calls `store` after a successful login and `erase` after a failed one: nothing is ever written or removed
[ "${1:-}" = "get" ] || exit 0

protocol=""; host=""
while IFS='=' read -r key value; do
  [ -n "$key" ] || break
  case "$key" in
    protocol) protocol="$value" ;;
    host) host="$value" ;;
  esac
done

if [ "$protocol" != "https" ] || [ "$host" != "$ALLOW_HOST" ]; then
  note DEBUG "no answer for ${protocol:-?}://${host:-?} (only https://$ALLOW_HOST)"
  exit 0
fi
[[ "$TOKEN_VAR" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || { note ERROR "bad variable name in AGENT_TEAM_TOKEN_VAR"; exit 0; }
if [ ! -r "$ENV_FILE" ]; then
  note WARNING "cannot read $ENV_FILE as $(id -un): no credential for https://$host (a deploy key or AGENT_TEAM_DISPATCHER_ENV — see deploy/service/README.md)"
  exit 0
fi
# the last `VAR=value` line, as team/config.py reads it: an inline `# comment` and surrounding quotes are not part of the value
token="$(sed -n "s/^[[:space:]]*\(export[[:space:]]\{1,\}\)\{0,1\}${TOKEN_VAR}[[:space:]]*=//p" "$ENV_FILE" | tail -n 1 | sed 's/#.*$//' | tr -d '\r' | sed "s/^[[:space:]]*//; s/[[:space:]]*\$//; s/^\"\(.*\)\"\$/\1/; s/^'\(.*\)'\$/\1/")"
if [ -z "$token" ]; then
  note WARNING "$TOKEN_VAR is empty or absent in $ENV_FILE: no credential for https://$host"
  exit 0
fi
note INFO "credential for https://$host from $TOKEN_VAR in $ENV_FILE (user $CRED_USER, asked by $(id -un))"
printf 'username=%s\npassword=%s\n' "$CRED_USER" "$token"
