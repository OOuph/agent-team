{
 "title": "po-decision",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "decisions",
  "answers",
  "ready_tasks",
  "owner_questions",
  "no_new_tasks",
  "digest_md"
 ],
 "properties": {
  "decisions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "observation_id",
     "action",
     "reason"
    ],
    "properties": {
     "observation_id": {
      "type": "string"
     },
     "action": {
      "type": "string",
      "enum": [
       "link",
       "needs_evidence",
       "create_task",
       "defer",
       "reject"
      ]
     },
     "linked_to": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "maxLength": 500
     },
     "return_condition": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "answers": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "question_id",
     "answer"
    ],
    "properties": {
     "question_id": {
      "type": "string"
     },
     "answer": {
      "type": "string",
      "maxLength": 1500
     },
     "not_before": {
      "type": "string",
      "maxLength": 40,
      "description": "ISO 8601 UTC: when the answer is 'wait until X' for a dated task, set this and the task will not start before X (otherwise it restarts next cycle and blocks again)"
     }
    }
   }
  },
  "ready_tasks": {
   "type": "array",
   "maxItems": 3,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "type",
     "problem",
     "scope",
     "acceptance",
     "negative_cases",
     "goal",
     "priority",
     "size",
     "role"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "type": {
      "type": "string",
      "enum": [
       "feature",
       "defect",
       "quality",
       "research",
       "content",
       "marketing",
       "ops"
      ]
     },
     "problem": {
      "type": "string",
      "maxLength": 800
     },
     "scope": {
      "type": "string",
      "maxLength": 800
     },
     "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
       "type": "string",
       "maxLength": 300
      }
     },
     "negative_cases": {
      "type": "array",
      "maxItems": 4,
      "items": {
       "type": "string",
       "maxLength": 300
      }
     },
     "goal": {
      "type": "string",
      "maxLength": 120,
      "description": "the goal/metric id from VISION this task serves"
     },
     "priority": {
      "type": "string",
      "enum": [
       "P0",
       "P1",
       "P2",
       "P3"
      ]
     },
     "size": {
      "type": "string",
      "enum": [
       "XS",
       "S",
       "M"
      ]
     },
     "role": {
      "type": "string",
      "enum": [
       "developer",
       "marketer",
       "analyst"
      ]
     },
     "observations": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "links": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "not_before": {
      "type": "string",
      "maxLength": 40,
      "description": "ISO 8601 UTC; the dispatcher does not start the task before this moment (daily posts, data that appears at a known hour). Omit when the task can start now."
     },
     "depends_on": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "Task ids that must be accepted/done with a non-stub result before this task starts (e.g. a task that consumes another task's report). Omit when independent."
     },
     "plan": {
      "type": "boolean",
      "description": "marketing-plan task: role marketer, type marketing. The marketer writes products/<slug>/marketing-plan.md (a week of slots per channel with dates UTC, rubrics, the VISION goal of every post, what to drop) and the task is accepted by that file, without a post. Create one when there is no plan or the plan is older than 7 days; otherwise cut the plan into post tasks with not_before."
     },
     "repo_only": {
      "type": "boolean",
      "description": "true when the acceptance criteria name repo files (mcp/, tests, README, code) that the site does not serve: the reviewer then gets a read-only checkout of the merged commit. Omit for tasks checkable on the live site."
     },
     "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required for type feature (owner 07.11): without evidence from real people the feature waits in proposed.",
      "required": [
       "who",
       "pain",
       "evidence",
       "change",
       "expected_effect",
       "metric",
       "min_sample",
       "read_on",
       "score"
      ],
      "properties": {
       "who": {
        "type": "string",
        "maxLength": 200
       },
       "pain": {
        "type": "string",
        "maxLength": 300,
        "description": "the problem in the people's words"
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
         "type": "string",
         "maxLength": 300
        },
        "description": "voice:<day>:<pain id> from VOICE OF THE USER, an OBS id of class feedback/voice, an outside URL of a real person's words, or metric:<what> (never alone)"
       },
       "change": {
        "type": "string",
        "maxLength": 300
       },
       "expected_effect": {
        "type": "string",
        "maxLength": 300
       },
       "metric": {
        "type": "string",
        "maxLength": 200,
        "description": "a count we already have (LATEST METRICS), or the path to ask ops for"
       },
       "min_sample": {
        "type": "integer",
        "minimum": 1,
        "description": "how many real people (visits, clicks) it takes to read the effect"
       },
       "read_on": {
        "type": "string",
        "maxLength": 10,
        "description": "YYYY-MM-DD in the future: the day the PO reads the metric"
       },
       "score": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "reach",
         "pain",
         "confidence",
         "ease"
        ],
        "properties": {
         "reach": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "pain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "ease": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         }
        }
       }
      }
     }
    }
   }
  },
  "reprioritize": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "task_id",
     "priority",
     "reason"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "priority": {
      "type": "string",
      "enum": [
       "P0",
       "P1",
       "P2",
       "P3"
      ]
     },
     "reason": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "owner_questions": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "question",
     "why_owner"
    ],
    "properties": {
     "question": {
      "type": "string",
      "maxLength": 600
     },
     "why_owner": {
      "type": "string",
      "maxLength": 300
     },
     "task_id": {
      "type": "string"
     }
    }
   }
  },
  "no_new_tasks": {
   "type": "boolean"
  },
  "digest_md": {
   "type": "string",
   "maxLength": 3000,
   "description": "Markdown digest for the owner, Russian, ≤ 250 words"
  },
  "close_tasks": {
   "type": "array",
   "maxItems": 10,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "task_id",
     "reason"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "reason": {
      "type": "string",
      "maxLength": 300
     }
    }
   },
   "description": "open tasks to close as rejected (duplicates of another task, no longer needed); not for claimed/in_progress ones"
  },
  "promote_tasks": {
   "type": "array",
   "maxItems": 5,
   "description": "Attach a hypothesis to an existing proposed (or ready) feature; the dispatcher moves it to ready when the rule is met",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "task_id",
     "hypothesis"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "description": "Required for type feature (owner 07.11): without evidence from real people the feature waits in proposed.",
      "required": [
       "who",
       "pain",
       "evidence",
       "change",
       "expected_effect",
       "metric",
       "min_sample",
       "read_on",
       "score"
      ],
      "properties": {
       "who": {
        "type": "string",
        "maxLength": 200
       },
       "pain": {
        "type": "string",
        "maxLength": 300,
        "description": "the problem in the people's words"
       },
       "evidence": {
        "type": "array",
        "minItems": 1,
        "maxItems": 6,
        "items": {
         "type": "string",
         "maxLength": 300
        },
        "description": "voice:<day>:<pain id> from VOICE OF THE USER, an OBS id of class feedback/voice, an outside URL of a real person's words, or metric:<what> (never alone)"
       },
       "change": {
        "type": "string",
        "maxLength": 300
       },
       "expected_effect": {
        "type": "string",
        "maxLength": 300
       },
       "metric": {
        "type": "string",
        "maxLength": 200,
        "description": "a count we already have (LATEST METRICS), or the path to ask ops for"
       },
       "min_sample": {
        "type": "integer",
        "minimum": 1,
        "description": "how many real people (visits, clicks) it takes to read the effect"
       },
       "read_on": {
        "type": "string",
        "maxLength": 10,
        "description": "YYYY-MM-DD in the future: the day the PO reads the metric"
       },
       "score": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "reach",
         "pain",
         "confidence",
         "ease"
        ],
        "properties": {
         "reach": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "pain": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "confidence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         },
         "ease": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
         }
        }
       }
      }
     }
    }
   }
  }
 }
}
