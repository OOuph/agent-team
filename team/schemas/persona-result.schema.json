{
 "title": "persona-result",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "outcome",
  "steps",
  "summary",
  "experience",
  "observations"
 ],
 "properties": {
  "outcome": {
   "type": "string",
   "enum": [
    "success",
    "product_limitation",
    "own_mistake",
    "environment_failure"
   ]
  },
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "url",
     "status",
     "note"
    ],
    "properties": {
     "url": {
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "note": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "summary": {
   "type": "string",
   "maxLength": 600
  },
  "observations": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "classification",
     "url",
     "expected",
     "actual"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "classification": {
      "type": "string",
      "enum": [
       "ux_friction",
       "value_gap",
       "reproducible_defect",
       "need_hypothesis",
       "environment_error"
      ]
     },
     "url": {
      "type": "string"
     },
     "expected": {
      "type": "string",
      "maxLength": 300
     },
     "actual": {
      "type": "string",
      "maxLength": 300
     },
     "confidence": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high"
      ]
     }
    }
   }
  },
  "experience": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "first_impression",
    "steps_to_understand",
    "interest",
    "usefulness",
    "would_return",
    "would_share",
    "why",
    "wish"
   ],
   "properties": {
    "first_impression": {
     "type": "string",
     "maxLength": 300
    },
    "steps_to_understand": {
     "type": "integer",
     "minimum": 0,
     "maximum": 30,
     "description": "fetches until the persona understood what the page gives them; 0 = never"
    },
    "interest": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "usefulness": {
     "type": "integer",
     "minimum": 1,
     "maximum": 5
    },
    "would_return": {
     "type": "string",
     "enum": [
      "yes",
      "maybe",
      "no"
     ]
    },
    "would_share": {
     "type": "string",
     "enum": [
      "yes",
      "maybe",
      "no"
     ]
    },
    "why": {
     "type": "string",
     "maxLength": 400
    },
    "wish": {
     "type": "string",
     "maxLength": 300,
     "description": "the single change that would make this persona come back"
    }
   }
  }
 }
}
