{
 "title": "analyst-report",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "summary_md",
  "observations"
 ],
 "properties": {
  "summary_md": {
   "type": "string",
   "maxLength": 2500
  },
  "observations": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "classification",
     "evidence",
     "actual"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "classification": {
      "type": "string",
      "enum": [
       "measurement",
       "reproducible_defect",
       "need_hypothesis"
      ]
     },
     "evidence": {
      "type": "string",
      "maxLength": 300
     },
     "actual": {
      "type": "string",
      "maxLength": 400
     },
     "url": {
      "type": "string"
     }
    }
   }
  },
  "task_effects": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "task_id",
     "effect",
     "evidence"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "effect": {
      "type": "string",
      "enum": [
       "positive",
       "none",
       "negative",
       "insufficient_data"
      ]
     },
     "evidence": {
      "type": "string",
      "maxLength": 400
     }
    }
   },
   "description": "optional: only a task that has its OWN metric with a before and an after; everything else is judged by theme"
  },
  "goal_status": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "goal",
     "value",
     "target",
     "on_track"
    ],
    "properties": {
     "goal": {
      "type": "string"
     },
     "value": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "on_track": {
      "type": "boolean"
     }
    }
   }
  },
  "theme_effects": {
   "type": "array",
   "maxItems": 12,
   "description": "the effect of a release or a theme of the day: the tasks of one deploy or of one goal judged together",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "theme",
     "task_ids",
     "effect",
     "evidence"
    ],
    "properties": {
     "theme": {
      "type": "string",
      "maxLength": 120,
      "description": "what the group is: a release (its commit) or a subject, e.g. «Challenge link»"
     },
     "task_ids": {
      "type": "array",
      "maxItems": 40,
      "items": {
       "type": "string"
      }
     },
     "effect": {
      "type": "string",
      "enum": [
       "positive",
       "none",
       "negative",
       "insufficient_data"
      ]
     },
     "evidence": {
      "type": "string",
      "maxLength": 400,
      "description": "the metric, before → after, over which days"
     }
    }
   }
  }
 }
}
