{
 "title": "analyst-report",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "summary_md",
  "observations"
 ],
 "properties": {
  "summary_md": {
   "type": "string",
   "maxLength": 2500
  },
  "observations": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "classification",
     "evidence",
     "actual"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "classification": {
      "type": "string",
      "enum": [
       "measurement",
       "reproducible_defect",
       "need_hypothesis"
      ]
     },
     "evidence": {
      "type": "string",
      "maxLength": 300
     },
     "actual": {
      "type": "string",
      "maxLength": 400
     },
     "url": {
      "type": "string"
     }
    }
   }
  },
  "task_effects": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "task_id",
     "effect",
     "evidence"
    ],
    "properties": {
     "task_id": {
      "type": "string"
     },
     "effect": {
      "type": "string",
      "enum": [
       "positive",
       "none",
       "negative",
       "insufficient_data"
      ]
     },
     "evidence": {
      "type": "string",
      "maxLength": 400
     }
    }
   },
   "description": "optional. Not asked for when the prompt has a DAY TO DAY section; otherwise the effect of an accepted task that has its own before/after"
  },
  "goal_status": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "goal",
     "value",
     "target",
     "on_track"
    ],
    "properties": {
     "goal": {
      "type": "string"
     },
     "value": {
      "type": "string"
     },
     "target": {
      "type": "string"
     },
     "on_track": {
      "type": "boolean"
     }
    }
   }
  },
  "task_status": {
   "type": "string",
   "enum": [
    "done",
    "needs_data",
    "blocked"
   ],
   "description": "An analyst TASK only (not the daily measurement): done = the deliverable is in this report; needs_data = keyword data is needed (see data_request); blocked = something else is missing"
  },
  "missing": {
   "type": "array",
   "maxItems": 8,
   "items": {
    "type": "string",
    "maxLength": 300
   }
  },
  "data_request": {
   "type": "object",
   "additionalProperties": false,
   "description": "Keyword data the dispatcher fetches for this task (DataForSEO, Bing Webmaster); you are run again with the tables",
   "properties": {
    "keywords": {
     "type": "array",
     "maxItems": 1000,
     "items": {
      "type": "string",
      "maxLength": 80
     }
    },
    "locations": {
     "type": "array",
     "items": {
      "type": "string"
     }
    },
    "sources": {
     "type": "array",
     "items": {
      "type": "string",
      "enum": [
       "google_ads_volume",
       "ranked_keywords",
       "bing_keyword",
       "bing_related"
      ]
     }
    },
    "competitors": {
     "type": "array",
     "maxItems": 10,
     "items": {
      "type": "string"
     }
    },
    "include": {
     "type": "array",
     "maxItems": 8,
     "items": {
      "type": "string"
     }
    }
   }
  },
  "files": {
   "type": "array",
   "maxItems": 4,
   "description": "Whole documents the dispatcher commits (paths under keywords.outputs)",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "path",
     "content"
    ],
    "properties": {
     "path": {
      "type": "string",
      "maxLength": 200
     },
     "content": {
      "type": "string",
      "maxLength": 60000
     }
    }
   }
  }
 }
}
