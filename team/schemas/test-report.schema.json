{
 "title": "test-report",
 "description": "Verdict of the tester role (game profile, owner 20.11): the same core as review-verdict (so the dispatcher treats it alike) plus what was played — scenarios in browsers, console errors, latency, screenshots.",
 "type": "object",
 "additionalProperties": false,
 "required": ["verdict", "steps", "criteria", "scenarios", "summary"],
 "properties": {
  "verdict": {"type": "string", "enum": ["pass", "fail", "inconclusive"]},
  "steps": {
   "type": "array",
   "items": {"type": "object", "additionalProperties": false, "required": ["url", "status", "note"],
             "properties": {"url": {"type": "string"}, "status": {"type": "integer"}, "note": {"type": "string", "maxLength": 200}}}
  },
  "criteria": {
   "type": "array",
   "items": {"type": "object", "additionalProperties": false, "required": ["criterion", "met", "evidence"],
             "properties": {"criterion": {"type": "string", "maxLength": 300}, "met": {"type": "boolean"}, "evidence": {"type": "string", "maxLength": 300}}}
  },
  "scenarios": {
   "type": "array", "maxItems": 30,
   "description": "what was played: a Playwright test (from `team-play test`) or a manual browser step; one entry per scenario",
   "items": {"type": "object", "additionalProperties": false, "required": ["name", "status", "evidence"],
             "properties": {"name": {"type": "string", "maxLength": 200},
                            "status": {"type": "string", "enum": ["passed", "failed", "flaky", "skipped", "not_run"]},
                            "clients": {"type": "integer", "description": "browser contexts the scenario used"},
                            "evidence": {"type": "string", "maxLength": 300, "description": "the team-play line, the error head, or the screenshot name"},
                            "screenshot": {"type": "string", "maxLength": 120}}}
  },
  "console_errors": {"type": "array", "maxItems": 10, "items": {"type": "string", "maxLength": 300}},
  "latency_ms": {
   "type": "object", "additionalProperties": false,
   "properties": {"p50": {"type": "number"}, "p95": {"type": "number"}, "samples": {"type": "integer"}, "how": {"type": "string", "maxLength": 200}}
  },
  "screenshots": {"type": "array", "maxItems": 20, "items": {"type": "string", "maxLength": 120}, "description": "file names in the review folder (team-play screenshot / test artifacts)"},
  "first_failure": {"type": "string", "maxLength": 400},
  "limits": {"type": "string", "maxLength": 400},
  "observations": {
   "type": "array", "maxItems": 5,
   "items": {"type": "object", "additionalProperties": false, "required": ["title", "classification", "url", "actual"],
             "properties": {"title": {"type": "string", "maxLength": 140},
                            "classification": {"type": "string", "enum": ["reproducible_defect", "success", "need_hypothesis", "environment_error", "ux_friction"]},
                            "url": {"type": "string"}, "expected": {"type": "string", "maxLength": 300}, "actual": {"type": "string", "maxLength": 300}}}
  },
  "summary": {"type": "string", "maxLength": 600},
  "friction": {
   "type": "array", "maxItems": 5,
   "items": {"type": "object", "additionalProperties": false, "required": ["kind", "what"],
             "properties": {"kind": {"type": "string", "enum": ["missing_tool", "denied_permission", "unclear_instruction", "schema_mismatch", "missing_data", "environment", "other"]},
                            "what": {"type": "string", "maxLength": 300}}}
  }
 }
}
