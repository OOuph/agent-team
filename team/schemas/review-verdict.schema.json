{
 "title": "review-verdict",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "verdict",
  "steps",
  "criteria",
  "summary"
 ],
 "properties": {
  "verdict": {
   "type": "string",
   "enum": [
    "pass",
    "fail",
    "inconclusive"
   ]
  },
  "steps": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "url",
     "status",
     "note"
    ],
    "properties": {
     "url": {
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "note": {
      "type": "string",
      "maxLength": 200
     }
    }
   }
  },
  "criteria": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "criterion",
     "met",
     "evidence"
    ],
    "properties": {
     "criterion": {
      "type": "string",
      "maxLength": 300
     },
     "met": {
      "type": "boolean"
     },
     "evidence": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "first_failure": {
   "type": "string",
   "maxLength": 400
  },
  "limits": {
   "type": "string",
   "maxLength": 400
  },
  "inconclusive_reason": {
   "type": "string",
   "enum": [
    "lock_timeout",
    "run_timeout",
    "no_tests_live",
    "no_tests",
    "server_not_started",
    "test_tooling",
    "no_test_for_criterion",
    "not_observable",
    "other"
   ],
   "description": "only with verdict inconclusive: why the check could not be made, one word from this list (team-play prints the word after `result`): lock_timeout = waited too long for the e2e host lock; run_timeout = the tests ran past the limit; no_tests_live = no test of the selection runs on the deployed host; no_tests = the selection is empty; server_not_started = the play-test or local server did not come up; test_tooling = no report, missing tool, bad arguments; no_test_for_criterion = no scenario covers the criterion; not_observable = the result cannot be seen in a test or a screenshot; other"
  },
  "observations": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "title",
     "classification",
     "url",
     "actual"
    ],
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 140
     },
     "classification": {
      "type": "string",
      "enum": [
       "reproducible_defect",
       "success",
       "need_hypothesis",
       "environment_error"
      ]
     },
     "url": {
      "type": "string"
     },
     "expected": {
      "type": "string",
      "maxLength": 300
     },
     "actual": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "summary": {
   "type": "string",
   "maxLength": 600
  },
  "friction": {
   "type": "array",
   "maxItems": 5,
   "description": "where the FRAMEWORK got in your way (not the product under review): a tool you lacked, a page team-fetch could not show you, an unclear instruction, a schema that did not fit",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "what"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "missing_tool",
       "denied_permission",
       "unclear_instruction",
       "schema_mismatch",
       "missing_data",
       "environment",
       "other"
      ]
     },
     "what": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  }
 }
}
