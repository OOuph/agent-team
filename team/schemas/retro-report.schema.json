{
 "title": "retro-report",
 "type": "object",
 "additionalProperties": false,
 "required": ["summary_md", "proposals", "no_action"],
 "properties": {
  "summary_md": {"type": "string", "maxLength": 3000, "description": "what the register says: recurring friction, by kind and role"},
  "proposals": {
   "type": "array",
   "maxItems": 6,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["title", "kind", "risk", "evidence", "files", "change", "acceptance"],
    "properties": {
     "title": {"type": "string", "maxLength": 120},
     "kind": {"type": "string", "enum": ["role_card", "docs", "config", "schema", "tooling", "dispatcher"]},
     "risk": {"type": "string", "enum": ["low", "medium", "high"]},
     "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "maxLength": 20}, "description": "friction ids F-0001"},
     "files": {"type": "array", "items": {"type": "string", "maxLength": 200}},
     "change": {"type": "string", "maxLength": 1500},
     "acceptance": {"type": "array", "minItems": 1, "maxItems": 5, "items": {"type": "string", "maxLength": 300}}
    }
   }
  },
  "no_action": {"type": "array", "items": {"type": "string", "maxLength": 300}, "description": "friction read as noise or one-off, and why"}
 }
}
