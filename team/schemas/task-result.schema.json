{
 "title": "task-result",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "status",
  "summary",
  "changes",
  "how_to_verify",
  "self_check"
 ],
 "properties": {
  "status": {
   "type": "string",
   "enum": [
    "done",
    "partial",
    "blocked"
   ]
  },
  "summary": {
   "type": "string",
   "maxLength": 1200
  },
  "changes": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 300
   },
   "description": "files or things changed; for marketing: post ids and urls"
  },
  "how_to_verify": {
   "type": "array",
   "items": {
    "type": "string",
    "maxLength": 300
   },
   "description": "public URLs and what the reviewer should see"
  },
  "self_check": {
   "type": "array",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "criterion",
     "met",
     "evidence"
    ],
    "properties": {
     "criterion": {
      "type": "string",
      "maxLength": 300
     },
     "met": {
      "type": "boolean"
     },
     "evidence": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  },
  "no_change_reason": {
   "type": "string",
   "maxLength": 600,
   "description": "status=done with no commits: why nothing needed to change (already satisfied); required then, with self_check evidence"
  },
  "question": {
   "type": "string",
   "maxLength": 800,
   "description": "only when status=blocked: what is needed"
  },
  "proposals": {
   "type": "array",
   "maxItems": 5,
   "items": {
    "type": "string",
    "maxLength": 300
   },
   "description": "things noticed for the backlog"
  },
  "branch": {
   "type": "string"
  },
  "commit": {
   "type": "string"
  },
  "friction": {
   "type": "array",
   "maxItems": 5,
   "description": "where the FRAMEWORK got in your way (not the product): a tool you lacked, a denied permission, an unclear instruction, a schema that did not fit, data you could not reach",
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "kind",
     "what"
    ],
    "properties": {
     "kind": {
      "type": "string",
      "enum": [
       "missing_tool",
       "denied_permission",
       "unclear_instruction",
       "schema_mismatch",
       "missing_data",
       "environment",
       "other"
      ]
     },
     "what": {
      "type": "string",
      "maxLength": 300
     }
    }
   }
  }
 }
}
